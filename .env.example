# ==============================================================================
# PORTFOLIO VISITOR ANALYTICS & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env (or .env.local) for local development:
#   cp .env.example .env
# In production (Vercel), add these variables under:
#   Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# Your MongoDB connection URI (e.g. MongoDB Atlas cluster or local MongoDB instance).
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio_analytics?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio_analytics?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE GEOLOCATION PROVIDER
# ------------------------------------------------------------------------------
# Set to 'false' to disable outbound IP geolocation lookup completely.
ANALYTICS_GEOLOCATION_ENABLED=true

# Geolocation lookup endpoint template. {ip} is replaced with the visitor's public IP.
# Default free endpoint: http://ip-api.com/json/{ip}?fields=status,message,country,countryCode,regionName,city,lat,lon,timezone,isp,org
GEOLOCATION_API_URL=http://ip-api.com/json/{ip}?fields=status,message,country,countryCode,regionName,city,lat,lon,timezone,isp,org

# Optional API key for commercial geolocation providers (e.g., ipapi.co, ipinfo.io, ipstack)
# Leave empty if using the default provider.
GEOLOCATION_API_KEY=

# ------------------------------------------------------------------------------
# 3. ANALYTICS LIFECYCLE & RETENTION
# ------------------------------------------------------------------------------
# Master switch to enable or disable analytics recording.
ANALYTICS_ENABLED=true

# Whether explicit cookie/analytics consent is required before tracking initializes.
# Set to 'false' for transparent privacy notice with opt-out / settings.
# Set to 'true' if your legal jurisdiction requires prior opt-in consent.
ANALYTICS_REQUIRE_CONSENT=false
VITE_ANALYTICS_REQUIRE_CONSENT=false

# Inactivity timeout in minutes before a returning visitor starts a new session (Default: 30)
ANALYTICS_SESSION_TIMEOUT_MINUTES=30

# Heartbeat ping interval in seconds to update active session duration (Default: 30)
ANALYTICS_HEARTBEAT_INTERVAL_SECONDS=30

# Detailed session retention period in days (Automatic MongoDB TTL deletion).
# Default: 90 days.
ANALYTICS_RETENTION_DAYS=90

# Raw IP retention period in days before automated masking/redaction (Default: 30 days)
ANALYTICS_RAW_IP_RETENTION_DAYS=30

# Whether to persist the raw public IP in MongoDB or only store derived geolocation.
# Default: true (for geographic auditability).
ANALYTICS_STORE_RAW_IP=true

# ------------------------------------------------------------------------------
# 4. ADMINISTRATIVE & DATA SUBJECT REQUESTS (GDPR / Erasure)
# ------------------------------------------------------------------------------
# Secret token required to access /api/analytics/manage for retention checks,
# data export, or deleting visitor records upon request.
# Generate a strong 32+ character random string.
ADMIN_AUTH_SECRET=your_super_secret_admin_token_here_replace_me

# ------------------------------------------------------------------------------
# 5. EXISTING THIRD-PARTY INTEGRATIONS (Preserved)
# ------------------------------------------------------------------------------
# LeetCode API / GitHub username configurations are handled in frontend data config.

